# Public URL of downloads.json written by ddugit's release workflow
# e.g. https://<project-ref>.supabase.co/storage/v1/object/public/releases/downloads.json
NEXT_PUBLIC_DOWNLOADS_URL=
# Supabase project (Project Settings → API): the URL and the publishable / anon key only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Lemon Squeezy checkout link for Pro (Products → Share); empty = "Available soon"
NEXT_PUBLIC_LS_CHECKOUT_URL=
# Server only (never NEXT_PUBLIC_): the same value as the report function's REPORT_FORWARD_SECRET
# (Supabase → Edge Functions → Secrets). Without it /api/report answers 503.
REPORT_FORWARD_SECRET=
# Server only: `true` lets /activate offer store test-mode licenses (set ALLOW_TEST_LICENSES in Supabase too).
# Only while trying a test purchase; leave it empty in production.
ALLOW_TEST_LICENSES=
